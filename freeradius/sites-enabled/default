# -*- text -*-
#
# Virtual server de MAC Authentication para a controladora Wi-Fi (Ruckus vSZ).
#
# Fluxo:
#   1. A controladora envia Access-Request com o MAC do cliente em User-Name
#      (e/ou Calling-Station-Id), em qualquer formato:
#      AA-BB-CC-DD-EE-FF, aa:bb:cc:dd:ee:ff, aabb.ccdd.eeff, AABBCCDDEEFF.
#   2. Normalizamos para "aabbccddeeff".
#   3. Consultamos a tabela radcheck (mantida pelo Laravel).
#      Achou  -> Auth-Type := Accept  -> Access-Accept
#      Não achou                      -> Access-Reject
#
# A senha (User-Password) é ignorada: quem decide é a presença do MAC na tabela.

server default {

listen {
	type = auth
	ipaddr = *
	port = 0
}

listen {
	type = acct
	ipaddr = *
	port = 0
}

authorize {
	# Normaliza o MAC vindo em User-Name; se não for MAC, tenta o Calling-Station-Id.
	if (&User-Name && &User-Name =~ /^([0-9a-f]{2})[-:.]?([0-9a-f]{2})[-:.]?([0-9a-f]{2})[-:.]?([0-9a-f]{2})[-:.]?([0-9a-f]{2})[-:.]?([0-9a-f]{2})$/i) {
		update request {
			&User-Name := "%{tolower:%{1}%{2}%{3}%{4}%{5}%{6}}"
		}
	}
	elsif (&Calling-Station-Id && &Calling-Station-Id =~ /^([0-9a-f]{2})[-:.]?([0-9a-f]{2})[-:.]?([0-9a-f]{2})[-:.]?([0-9a-f]{2})[-:.]?([0-9a-f]{2})[-:.]?([0-9a-f]{2})/i) {
		update request {
			&User-Name := "%{tolower:%{1}%{2}%{3}%{4}%{5}%{6}}"
		}
	}
	else {
		update reply {
			&Reply-Message := "MAC invalido"
		}
		reject
	}

	# Busca o MAC na radcheck. Se existir, a linha seta control:Auth-Type := Accept.
	sql

	if (notfound) {
		update reply {
			&Reply-Message := "MAC nao autorizado"
		}
		reject
	}
}

authenticate {
	# Nada a autenticar: Auth-Type Accept vem da radcheck.
}

preacct {
	preprocess
}

accounting {
	# Accounting não é registrado; apenas responde OK à controladora.
	ok
}

post-auth {
	Post-Auth-Type REJECT {
		attr_filter.access_reject
	}
}

}
